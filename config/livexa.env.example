# Livexa Configuration
# Rename to livexa.env

# Security (AES-256 Key for encryption module)
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LIVEXA_SECRET_KEY=

# Telegram Bot Token (Encrypted by default, specific to security.py implementation)
# To use plain text during setup, set LIVEXA_BOT_TOKEN_PLAIN (Not recommended for prod)
LIVEXA_BOT_TOKEN_ENC=
LIVEXA_BOT_TOKEN_PLAIN=

# Authorized Admin IDs (Comma separated)
LIVEXA_ADMIN_IDS=123456789,987654321

# Dispatcher Defaults
DEFAULT_STREAM_KEY=
